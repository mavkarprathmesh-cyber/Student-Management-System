{
  "name": "student-management-system",
  "version": "1.0.0",
  "description": "Production-Ready Complete Student Management System",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm run dev:client",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "build:all": "npm --prefix server run build && npm --prefix client run build",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server",
    "seed": "npm --prefix server run prisma:seed"
  },
  "keywords": ["student-management-system", "education", "react", "express", "prisma", "typescript"]
}
